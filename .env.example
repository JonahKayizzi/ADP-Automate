# Local / Render environment template — copy to .env (never commit secrets)

# Backend
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/adp_automate
DATABASE_USER=adp
DATABASE_PASSWORD=adp
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./data/uploads

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api

# Render Postgres often provides DATABASE_URL as postgres://user:pass@host/db
# Convert to jdbc:postgresql://host:5432/db before setting spring.datasource.url
